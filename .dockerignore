node_modules
.git
.next
.env.local
# .env is NOT ignored on purpose: the CI build job renders RUNTIME_CONFIG_CONTENT
# into .env in the build context, and `next build` inlines NEXT_PUBLIC_* from it
# into the client bundle. Ignoring it makes every NEXT_PUBLIC_* bake in EMPTY --
# the build still succeeds, the app is just silently broken at runtime.
# It never reaches the final image: the runner stage copies only .next, public,
# package.json and node_modules.
*.md
Dockerfile
.dockerignore
database/
seeders/
# pnpm-workspace.yaml hanya berisi allowBuilds untuk pnpm >=10 di host. Dockerfile
# memakai pnpm 9, yang membaca file ini sebagai definisi workspace dan gagal
# dengan "packages field missing or empty" saat `pnpm build`.
pnpm-workspace.yaml

# Brand guideline PDF (28 MB) tidak dibutuhkan saat build
