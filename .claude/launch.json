{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "Next.js Verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "run",
        "dev:next",
        "--port",
        "3100"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "Site Verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && BACKEND_URL=http://127.0.0.1:8190 exec pnpm run dev:next --port 3100 --hostname 127.0.0.1"
      ],
      "port": 3100,
      "url": "http://127.0.0.1:3100"
    }
  ]
}
