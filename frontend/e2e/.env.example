# Copy to e2e/.env.local (gitignored) for local runs; CI sets these as env.
# The seed (backend/database/scripts/e2e-seed.js) creates the accounts with
# the same values, so run it with these variables exported.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_STAFF_EMAIL=e2e-staff@nuhabit.test
E2E_STAFF_PASSWORD=
E2E_MEMBER_USERNAME=e2e-member@nuhabit.test
E2E_MEMBER_PASSWORD=
# Promo code the seed creates on the shop channel; empty skips the promo step.
E2E_PROMO_CODE=E2E10
# 1 presses Pay in the shop journey. Only with the API on XENDIT_MOCK=1:
# it creates a pending order and lands on the order status page.
E2E_SHOP_PAY_MOCK=0
# Parallel browsers; defaults to 4.
E2E_WORKERS=
