exports[`cancelUnpaidChildlessCheckout (karakterisasi) > sudah cancelled → idempoten; punya anak → ditolak; tidak ada → 404 1`] = `
{
  "already": {
    "result": {
      "checkoutId": "chk-1",
    },
    "trace": [
      "BEGIN",
      {
        "params": [
          "chk-1",
        ],
        "sql": "SELECT id, payment_status, notes, table_id FROM pos.pos_checkouts WHERE id = $1 FOR UPDATE",
      },
      "COMMIT",
    ],
  },
  "missing": {
    "error": {
      "message": "Checkout tidak ditemukan",
      "name": "MixedCheckoutError",
      "status": 404,
    },
    "trace": [
      "BEGIN",
      {
        "params": [
          "chk-1",
          "br-1",
        ],
        "sql": "SELECT id, payment_status, notes, table_id FROM pos.pos_checkouts WHERE id = $1 AND branch_id = $2 FOR UPDATE",
      },
      "ROLLBACK",
    ],
  },
  "withChildren": {
    "error": {
      "message": "Checkout dengan pesanan tidak bisa dibatalkan",
      "name": "MixedCheckoutError",
      "status": 400,
    },
    "trace": [
      "BEGIN",
      {
        "params": [
          "chk-1",
        ],
        "sql": "SELECT id, payment_status, notes, table_id FROM pos.pos_checkouts WHERE id = $1 FOR UPDATE",
      },
      {
        "params": [
          "chk-1",
        ],
        "sql": "SELECT COUNT(*)::int AS n FROM pos.pos_orders WHERE checkout_id = $1",
      },
      "ROLLBACK",
    ],
  },
}
`;

