# Copy to backend/.env.local for local development. Precedence: shell env,
# then .env.local, then .env (same as the migration runner).

# ── Database ──────────────────────────────────────────────────────────────
# Runtime pool. Falls back to MIGRATE_DATABASE_URL when empty.
DATABASE_URL=postgres://postgres@localhost:55432/nuhabit
# Target of `go -C backend run ./cmd/migrate [-apply]`. Non-local hosts are
# refused unless -allow-remote or ALLOW_REMOTE_DB=1.
MIGRATE_DATABASE_URL=postgres://postgres@localhost:55432/nuhabit
# ALLOW_REMOTE_DB=1
# MIGRATIONS_DIR=database/migrations

# ── Runtime ───────────────────────────────────────────────────────────────
PORT=8080
# development | production (NODE_ENV=production also counts as production)
APP_ENV=development
TZ=Asia/Jakarta
# debug | info | warn | error
LOG_LEVEL=info
# "all" mounts every module (modular monolith); a comma list mounts a subset,
# which turns the same binary into one service, e.g. MODULES=gym-credits
MODULES=all
# Prometheus metrics at GET /metrics on this separate address, without auth.
# Empty (the default) serves no metrics. Bind it where only the scraper
# reaches: 127.0.0.1:9090 on a host, :9090 inside a container whose port is
# not published. See docs/DEPLOY.md.
# METRICS_ADDR=127.0.0.1:9090
# Background jobs (purchase reconciliation, gym reminders) run in every
# replica that mounts their module; false stops this one. See docs/DEPLOY.md.
# JOBS_ENABLED=true

# Payroll payslips are emailed as PDF attachments after the run is paid.
# Use a sender on a verified domain; never use the Resend sandbox sender.
RESEND_API_KEY=
PAYROLL_FROM_EMAIL=
# Sender of gym notification emails (falls back to FROM_EMAIL); empty sends none.
GYM_FROM_EMAIL=

# ── Member portal ─────────────────────────────────────────────────────────
# Local-only OTP bypass; ignored in production and for non-local databases.
# MEMBER_OTP_DEV_CODE=000000

# Member portal codes (self sign-up, code sign-in, Google sign-up, code
# password reset) open at runtime when a WhatsApp provider or Resend email
# (RESEND_API_KEY plus GYM_FROM_EMAIL or FROM_EMAIL) is configured; GET
# /api/member-portal/config reports it. "false" forces them off and the OTP
# routes answer 503; members then sign in with the password the front desk
# sets. "true" also enables dataroom email verification.
OTP_ENABLED=

# ── Tests ─────────────────────────────────────────────────────────────────
# Integration tests skip unless this is set. They create and delete their own
# rows, so the local database is fine.
TEST_DATABASE_URL=postgres://postgres@localhost:55432/nuhabit
