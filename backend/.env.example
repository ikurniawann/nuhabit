# Copy to backend/.env.local for local development. Precedence: shell env,
# then .env.local, then .env (same as the migration runner).

# ── Database ──────────────────────────────────────────────────────────────
# Runtime pool. Falls back to MIGRATE_DATABASE_URL when empty.
DATABASE_URL=postgres://postgres@localhost:55432/nuhabit
# Target of `go -C backend run ./cmd/migrate [-apply]`. Non-local hosts are
# refused unless -allow-remote or ALLOW_REMOTE_DB=1.
MIGRATE_DATABASE_URL=postgres://postgres@localhost:55432/nuhabit
# ALLOW_REMOTE_DB=1
# MIGRATIONS_DIR=database/migrations

# ── Runtime ───────────────────────────────────────────────────────────────
PORT=8080
# development | production (NODE_ENV=production also counts as production)
APP_ENV=development
TZ=Asia/Jakarta
# debug | info | warn | error
LOG_LEVEL=info
# "all" mounts every module (modular monolith); a comma list mounts a subset,
# which turns the same binary into one service, e.g. MODULES=gym-credits
MODULES=all
# Prometheus metrics at GET /metrics on this separate address, without auth.
# Empty (the default) serves no metrics. Bind it where only the scraper
# reaches: 127.0.0.1:9090 on a host, :9090 inside a container whose port is
# not published. See docs/DEPLOY.md.
# METRICS_ADDR=127.0.0.1:9090
# Background jobs (purchase reconciliation, gym reminders) run in every
# replica that mounts their module; false stops this one. See docs/DEPLOY.md.
# JOBS_ENABLED=true

# ── Gym pass renewals ─────────────────────────────────────────────────────
# Invoice renewals redirect to NEXT_PUBLIC_APP_URL (or NEXT_PUBLIC_BASE_URL);
# without either the renewal job logs an error at startup and skips them.
# NEXT_PUBLIC_APP_URL=https://app.example.com
# Saved cards/e-wallets for auto-renew (off by default). Needs the Xendit
# gateway active in Settings → Payment Gateways. See docs/XENDIT_SAVED_METHODS.md.
# XENDIT_SAVED_METHODS_ENABLED=1
# XENDIT_SAVED_METHOD_CHANNELS=CARDS,OVO,DANA,SHOPEEPAY

# ── Email ─────────────────────────────────────────────────────────────────
# Settings → Integrasi → Email is the primary place to configure the mailer;
# every variable here is the fallback for a field left empty there. See
# docs/EMAIL.md. MAIL_PROVIDER: resend, microsoft or empty (automatic).
MAIL_PROVIDER=
FROM_EMAIL=
MAIL_FROM_NAME=
# Resend: a sender on a domain verified in Resend; never the sandbox sender.
RESEND_API_KEY=
# Microsoft 365 through Graph sendMail (app registration with the Mail.Send
# application permission and admin consent; MS_GRAPH_SENDER is the mailbox).
MAIL_MS_TRANSPORT=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=
# Microsoft 365 or outlook.com/hotmail.com through SMTP AUTH (STARTTLS on
# smtp.office365.com:587; an app password when MFA is on).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Per-module sender overrides (Resend only; Microsoft always sends from the
# configured mailbox). Each falls back to FROM_EMAIL.
PAYROLL_FROM_EMAIL=
GYM_FROM_EMAIL=
DATAROOM_FROM_EMAIL=

# ── Member portal ─────────────────────────────────────────────────────────
# Local-only OTP bypass; ignored in production and for non-local databases.
# MEMBER_OTP_DEV_CODE=000000

# Member portal codes (self sign-up, code sign-in, Google sign-up, code
# password reset) open at runtime when a WhatsApp provider or an email
# provider (Settings → Integrasi → Email, or the env above) is configured; GET
# /api/member-portal/config reports it. "false" forces them off and the OTP
# routes answer 503; members then sign in with the password the front desk
# sets. "true" also enables dataroom email verification.
OTP_ENABLED=

# ── Tests ─────────────────────────────────────────────────────────────────
# Integration tests skip unless this is set. They create and delete their own
# rows, so the local database is fine.
TEST_DATABASE_URL=postgres://postgres@localhost:55432/nuhabit
